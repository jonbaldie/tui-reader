  s2 --> s3: load document
  s2 --> s4: load document
  s3 --> s6: quit reader
  s3 --> s8: terminal program fails
  s2 --> s5: load document
  s2 --> s7: load document
  s4 --> s6: quit reader
  s4 --> s8: terminal program fails
